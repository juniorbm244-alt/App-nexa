datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  plan          String    @default("essential")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  assets    Asset[]
  expenses  Expense[]
  documents Document[]
  auditLogs AuditLog[]
  aiChats   AIConversation[]
  notifications Notification[]
  subscription  Subscription?
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum AssetType {
  IMOVEL
  VEICULO
  EMPRESA
  INVESTIMENTO
}

model Asset {
  id          String    @id @default(uuid())
  userId      String
  type        AssetType
  name        String
  estimatedValue Decimal @db.Decimal(14, 2)
  purchaseValue  Decimal? @db.Decimal(14, 2)
  purchaseDate   DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]
  expenses  Expense[]

  @@index([userId])
  @@index([userId, type])
}

model NetWorthSnapshot {
  id        String   @id @default(uuid())
  userId    String
  total     Decimal  @db.Decimal(14, 2)
  refMonth  DateTime
  createdAt DateTime @default(now())

  @@unique([userId, refMonth])
  @@index([userId])
}

model Expense {
  id         String   @id @default(uuid())
  userId     String
  assetId    String?
  category   String
  name       String
  amount     Decimal  @db.Decimal(12, 2)
  date       DateTime
  recurring  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Document {
  id          String    @id @default(uuid())
  userId      String
  assetId     String?
  name        String
  category    String
  fileUrl     String?
  issueDate   DateTime?
  dueDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
}

enum NotificationType {
  DOCUMENT_DUE
  EXPENSE_ANOMALY
  NET_WORTH_DROP
  SUBSCRIPTION
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  documentId String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, type, title])
  @@index([userId, read])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  plan                 String
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
